# Copier en .env (à côté de docker-compose.yml) et renseigner. Ne jamais committer .env.

# AUD de l'application Cloudflare Access (Zero Trust > Access > Applications > Configurer)
WEBAPP_ACCESS_AUD=
# E-mails des administrateurs, séparés par des virgules
WEBAPP_ADMINS=
# Jeton du tunnel Cloudflare (Zero Trust > Networks > Tunnels)
TUNNEL_TOKEN=

# Développement local uniquement : NE PAS activer en production
# (refus de démarrage si défini avec WEBAPP_ACCESS_AUD).
# WEBAPP_DEV_USER=dev@example.com
